{
  "_comment": "How Lighthouse starts each emulator. First profile whose package is installed wins for a platform. Placeholders: {path} ROM file path, {uri} FileProvider URI of the ROM (granted along with the files a .cue/.m3u names), {package} the installed package, {ime} default input method, {core} the installed core (core may be a list of alternatives; the first one installed is used). rom: content = FileProvider URI as intent data; document = document-shaped URI as intent data (for emulators that only accept those, e.g. PPSSPP); extras = path only in extras; steamAppId = app id read from a .steam shortcut file.",
  "profiles": [
    {
      "id": "eden",
      "label": "Eden",
      "platforms": ["switch"],
      "packages": ["dev.eden.eden_emulator"],
      "activity": "org.yuzu.yuzu_emu.activities.EmulationActivity",
      "action": "android.intent.action.VIEW",
      "rom": "content",
      "mime": "application/octet-stream"
    },
    {
      "id": "armsx2",
      "label": "ARMSX2",
      "platforms": ["ps2"],
      "packages": ["com.armsx2"],
      "activity": "com.armsx2.BootSplashActivity",
      "action": "android.intent.action.VIEW",
      "rom": "content",
      "mime": "application/octet-stream"
    },
    {
      "id": "duckstation",
      "label": "DuckStation",
      "platforms": ["ps1"],
      "packages": ["com.github.stenzek.duckstation"],
      "activity": "com.github.stenzek.duckstation.EmulationActivity",
      "action": "android.intent.action.MAIN",
      "rom": "extras",
      "extras": {"bootPath": "{uri}", "resumeState": false}
    },
    {
      "id": "ppsspp",
      "label": "PPSSPP",
      "platforms": ["psp"],
      "packages": ["org.ppsspp.ppssppgold", "org.ppsspp.ppsspp"],
      "activity": "org.ppsspp.ppsspp.PpssppActivity",
      "action": "android.intent.action.VIEW",
      "rom": "document",
      "mime": "application/octet-stream"
    },
    {
      "id": "retroarch-mgba",
      "label": "RetroArch · mGBA",
      "platforms": ["gba", "gbc"],
      "packages": ["com.retroarch.aarch64", "com.retroarch"],
      "activity": "com.retroarch.browser.retroactivity.RetroActivityFuture",
      "action": "android.intent.action.MAIN",
      "rom": "extras",
      "needsStorage": true,
      "core": "/data/user/0/{package}/cores/mgba_libretro_android.so",
      "extras": {
        "ROM": "{path}",
        "LIBRETRO": "/data/user/0/{package}/cores/mgba_libretro_android.so",
        "CONFIGFILE": "/storage/emulated/0/Android/data/{package}/files/retroarch.cfg",
        "IME": "{ime}",
        "DATADIR": "/data/user/0/{package}",
        "SDCARD": "/storage/emulated/0",
        "EXTERNAL": "/storage/emulated/0/Android/data/{package}/files"
      }
    },
