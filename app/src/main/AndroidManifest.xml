<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the app drawer hand an app to the system uninstall dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Play time: Usage access, granted by the user in Android settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Cover art only (SteamGridDB, libretro thumbnails), and only when the user asks. No analytics. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Quick settings: read-only Wi-Fi/network state, Bluetooth device list (asked at runtime). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11: BLUETOOTH_CONNECT doesn't exist; this install-time permission covers device names. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Only to show the Wi-Fi network name on non-rooted devices (Android ties SSIDs to location). Asked on demand. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Handheld/TV friendly: no touchscreen required, gamepad supported. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- The Android tab lists launchable apps; declared narrowly instead of QUERY_ALL_PACKAGES (Play-friendly). -->
    <queries>
        <!-- Moonlight: its PC games' box art (poster provider) and launch shortcut. -->
        <package android:name="com.limelight" />
        <!-- Tailscale: the Network panel turns its VPN on and off through its exported receiver. -->
        <package android:name="com.tailscale.ipn" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Crash reports: offer "Email it" only when an email app is installed. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".LighthouseApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lighthouse">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets Lighthouse be chosen as the default home app (Settings > Apps > Default apps > Home app). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Accepts "Create shortcut" / "Add to home screen" requests while Lighthouse is the Home app. -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
        <!-- Hands ROMs to emulators as content:// URIs with a per-launch read grant (no file:// exposure). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.roms"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rom_paths" />
        </provider>
        <!-- The same ROMs as document-shaped links, for emulators (PPSSPP) that only accept those. -->
        <provider
            android:name=".launch.RomDocumentProvider"
            android:authorities="${applicationId}.romdocs"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
